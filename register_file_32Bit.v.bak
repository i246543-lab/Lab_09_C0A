module testbench_32Bit_reg_file();
reg write_enable, clk, reset;
reg [4:0] wr, rd1, rd2;
reg [31:0] data_in;
wire [31:0] data_out1, data_out2;
register_file_32x32 uut(clk, reset, write_enable, wr, rd1, rd2, data_in, data_out1, data_out2);
always 
#5 clk= ~clk;
initial
begin
data_in=0;
wr=0;
reset=0;
write_enable=0;
rd1=0;
rd2=0;
clk=0;
reset=1;
#10
reset=0;
@(posedge clk);
write_enable=1;
wr= 5'd1;
data_in= 32'd100;
@(posedge clk);
wr= 5'd2;       
data_in= 32'd50;
@(posedge clk);
wr= 5'd3;       
data_in= 32'd7;
@(posedge clk);
wr= 5'd4;       
data_in= 32'd15;
@(posedge clk);
write_enable=0;
rd1= 5'd1;
rd2= 5'd2;
@(posedge clk);
rd1= 5'd2;
rd2= 5'd1;
@(posedge clk);
rd1= 5'd3;
rd2= 5'd4;
end
endmodule
