module decoder_5_to32(wr, write_enable, dec_out);
input [4:0] wr;
input write_enable;
output reg [31:0] dec_out;
    always @(*) begin
        dec_out= 32'h00000000;
       if(write_enable &&(wr!= 5'd0))
            dec_out[wr]= 1'b1;
    end
endmodule
module mux32_1(sel, out);
reg [31:0] reg_data [0:31]; //32-bit data n 32 registers 
input [4:0] sel;
output reg [31:0] out;
    always @(*) begin
        if(sel==5'd0)
            out= 32'h00000000;
        else
        out= reg_data[sel];
    end
endmodule
module register_32bit(load, clk, reset, d, q);
input clk, load, reset; //decoder output (load)
input [31:0] d; //data input
output reg [31:0] q;
    always @ (posedge clk) begin
        if(reset)
            q <= 32'h00000000;
        else if(load)
            q <= d;
    end
endmodule
